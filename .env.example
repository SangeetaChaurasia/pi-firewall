# Copy this file to `.env` (same folder) and fill in your key. `.env` is git-ignored.
#   Windows:  copy .env.example .env
# Real environment variables always take priority over this file.

# --- Layer 3 (LLM judge) + the real-LLM agent in the demo -------------------------------------
OPENAI_API_KEY=your-openai-api-key-here

# Judge model. gpt-4.1-mini is fast + cheap and needs no special parameters.
# Cheaper alternatives: gpt-5.4-nano, gpt-5-nano (reasoning models; slightly slower).
OPENAI_MODEL=gpt-4.1-mini

# auto = judge ON only if OPENAI_API_KEY is set (default) | on | off
PIF_LLM_JUDGE=auto

# Hard spend cap: max judge API calls per process. ~300 calls on a *-mini model costs cents.
PIF_LLM_MAX_CALLS=300

# --- Optional -------------------------------------------------------------------------------
# PIF_ML_ENABLED=true            # Layer 2 DeBERTa classifier (needs torch + transformers)
# PIF_ML_MODEL=protectai/deberta-v3-base-prompt-injection-v2
# OPENAI_BASE_URL=               # only for Azure / OpenAI-compatible gateways
